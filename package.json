{
  "name": "tipsy-isle",
  "version": "1.1.2",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/plugin-sdk"],
  "description": "TipsyIsle — A local AI roleplay client built on an independent architecture for players, creators, and developers",
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 5179",
    "dev:gateway": "node server/gateway.mjs",
    "dev:compat": "node server/compatibility-host.mjs",
    "build": "vite build",
    "plugin:keygen": "node scripts/plugin-pack.mjs keygen",
    "plugin:pack": "node scripts/plugin-pack.mjs pack",
    "plugin:examples": "node scripts/plugin-pack.mjs examples",
    "icons:generate": "node scripts/generate-icons.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5179",
    "tauri": "tauri",
    "android:init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 init",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 build",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android.ps1 dev",
    "windows:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows.ps1 build",
    "windows:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows.ps1 dev"
  },
  "dependencies": {
    "@babel/parser": "7.29.14",
    "@earendil-works/pi-ai": "1.3.0",
    "@faker-js/faker": "9.7.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@oddbird/popover-polyfill": "0.7.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "ajv": "8.17.1",
    "cropperjs": "1.6.2",
    "dompurify": "3.4.18",
    "droll": "0.2.1",
    "ejs": "^7.0.2",
    "fflate": "0.8.2",
    "fuse.js": "7.1.0",
    "gpt-tokenizer": "4.1.2",
    "immer": "10.1.1",
    "jquery": "^4.0.0",
    "json5": "2.2.3",
    "jsonrepair": "3.13.1",
    "lodash": "^4.18.1",
    "mathjs": "12.4.1",
    "moment": "2.31.0",
    "node-unrar-js": "2.0.2",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "seedrandom": "3.0.5",
    "semver": "7.7.3",
    "showdown": "2.1.0",
    "vue": "3.5.21",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
