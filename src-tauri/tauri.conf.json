{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TipsyIsle",
  "version": "1.1.3",
  "identifier": "com.xiaoleng.tipsyisle",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev:web",
    "devUrl": "http://localhost:5179",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "微醺屿 · TipsyIsle",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 620,
        "resizable": true,
        "label": "main",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
