{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tipsy-isle.dev/schema/native-plugin/v1/manifest.json",
  "title": "TipsyIsle native plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "name", "publisher", "version", "hostApi", "storageVersion", "permissions", "entrypoints"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "id": { "type": "string", "maxLength": 100, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 600 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "hostApi": { "type": "string", "minLength": 1, "maxLength": 120 },
    "storageVersion": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "enum": ["story.read", "story.events", "storage.device", "storage.route", "storage.reply", "ui.panel", "composer.draft", "generation.contribute", "resources.read", "story.history", "story.variables", "story.edit", "story.navigate", "assets.read", "assets.write", "generation.pipeline", "generation.tools", "models.use", "network.request", "media.manage", "index.manage", "services.provide", "services.call", "ui.surface", "jobs.run", "ui.stage", "ui.export"] } },
    "entrypoints": {
      "type": "object", "additionalProperties": false, "required": ["main"],
      "properties": { "main": { "$ref": "#/definitions/entry" }, "migrate": { "$ref": "#/definitions/entry" } }
    },
    "resources": { "type": "array", "maxItems": 60, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } },
    "commands": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "location"],
        "properties": {
          "id": { "$ref": "#/definitions/id" }, "label": { "$ref": "#/definitions/label" }, "location": { "enum": ["composer", "message", "workspace"] },
          "role": { "enum": ["assistant", "user", "system"] }, "latestOnly": { "type": "boolean" },
          "surface": { "enum": ["dialog", "sidebar", "fullscreen"] }
        }
      }
    },
    "events": { "type": "array", "uniqueItems": true, "items": { "enum": ["story.replySaved", "story.routeChanged", "story.changed", "story.replyCheckpoint"] } },
    "generation": { "type": "boolean" },
    "pipeline": { "type": "array", "uniqueItems": true, "items": { "enum": ["beforeScan", "afterScan"] } },
    "macros": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "tools": {
      "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "description", "parameters"], "properties": {
          "id": { "$ref": "#/definitions/id" }, "description": { "type": "string", "minLength": 1, "maxLength": 800 },
          "parameters": { "type": "object" }
        }
      }
    },
    "provides": {
      "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "version", "methods"], "properties": {
          "id": { "$ref": "#/definitions/service" }, "version": { "type": "string", "maxLength": 64 },
          "methods": { "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } }
        }
      }
    },
    "consumes": {
      "type": "array", "maxItems": 24, "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "range"], "properties": { "id": { "$ref": "#/definitions/service" }, "range": { "type": "string", "maxLength": 120 } }
      }
    },
    "origins": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "maxLength": 300 } },
    "settings": {
      "type": "array", "maxItems": 24,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "type", "default"],
        "properties": {
          "id": { "$ref": "#/definitions/id" }, "label": { "$ref": "#/definitions/label" }, "description": { "type": "string", "maxLength": 400 },
          "type": { "enum": ["text", "number", "boolean", "select"] }, "default": { "type": ["string", "number", "boolean"], "maxLength": 2000 },
          "min": { "type": "number" }, "max": { "type": "number" },
          "options": {
            "type": "array", "minItems": 1, "maxItems": 24,
            "items": { "type": "object", "required": ["value", "label"], "additionalProperties": false, "properties": {
              "value": { "type": "string", "maxLength": 200 }, "label": { "$ref": "#/definitions/label" }
            } }
          }
        }
      }
    }
  },
  "definitions": {
    "service": { "type": "string", "maxLength": 166, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$" },
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "path": { "type": "string", "maxLength": 180, "pattern": "^(?:[a-zA-Z0-9_-][a-zA-Z0-9_.-]*/)*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$" },
    "entry": { "allOf": [{ "$ref": "#/definitions/path" }, { "type": "string", "pattern": "\\.js$" }] }
  }
}
